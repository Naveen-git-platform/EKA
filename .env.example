# ===== Application =====
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data

# ===== LLM (groq | openai | together | fake) =====
LLM_PROVIDER=groq
# Leave LLM_MODEL empty to use the provider default
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
GROQ_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=

# ===== Embeddings (sentence-transformers | openai | fake) =====
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ===== Vector DB (Qdrant) =====
# Leave QDRANT_URL empty to use embedded local storage at QDRANT_PATH
QDRANT_URL=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=eka_chunks

# ===== Ingestion =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=25

# ===== Retrieval =====
RETRIEVAL_TOP_K=5
# rrf | weighted
FUSION_METHOD=rrf
RRF_K=60
# used when FUSION_METHOD=weighted
VECTOR_WEIGHT=0.5

# ===== Agents =====
MAX_RETRIEVAL_LOOPS=2
MAX_HISTORY_TURNS=6

# ===== Evaluation (custom | ragas) =====
EVAL_BACKEND=custom
EVAL_AFTER_QUERY=false

# ===== Frontend =====
BACKEND_URL=http://localhost:8000
